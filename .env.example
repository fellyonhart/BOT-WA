# Nomor admin bot (angka saja, pisahkan koma jika lebih dari satu)
BOT_ADMINS=628xxxxxxxxxx

# Dashboard admin (wajib untuk panel web)
DASHBOARD_PASSWORD=admin123

# Opsional: login dengan pairing code
PAIR_NUMBER=628xxxxxxxxxx

# Opsional: download media (yt-dlp) & stiker (ffmpeg)
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# YTDLP_COOKIES=./cookies.txt   # untuk IG/YouTube yang minta login
# MEDIA_MAX_MB=50
# MEDIA_MAX_MENIT=15
# STICKER_PACK=PPLG X-3
# STICKER_AUTHOR=feyy

# Menu tombol + list native-flow (eksperimental). Isi "on" jika berfungsi di perangkat.
INTERACTIVE_MENU=on

# AI (perintah `ai`) — pilih satu provider dan isi kuncinya
# AI_PROVIDER=groq              # groq | gemini | openrouter
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# AI_MAX_TOKENS=500
# AI_SYSTEM_PROMPT=Kamu adalah asisten kelas PPLG X-3. Jawab ramah, singkat, bahasa Indonesia santai.
# AI_VISION_MODEL=qwen/qwen3.8-27b     # untuk tanya gambar (groq / openrouter)
# AI_VISION_MAX_TOKENS=800
